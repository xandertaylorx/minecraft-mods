{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui", "ground"],
        "model": { "type": "minecraft:model", "model": "hero_arsenal:item/star_shield" }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": { "type": "minecraft:model", "model": "hero_arsenal:item/star_shield_blocking" },
      "on_false": { "type": "minecraft:model", "model": "hero_arsenal:item/star_shield_in_hand" }
    }
  }
}
